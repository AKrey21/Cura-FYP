cura/eval/datasets/tts-listening-test/
cura/eval/datasets/tts-listening-test.zip
# Report build junk: headless-Edge profiles + temp PDF from build_pdf.py
report/_edge_tmp*/
report/_print.tmp.pdf
report/_stamped.tmp.pdf
report/_pagenums.html
report/_pagenums.pdf
# Offline copies of cited sources: third-party PDFs, 165 MB, refetchable with
# python report/fetch_references.py (the manifest + verification log are tracked)
report/references-pdfs/*.pdf
report/references-pdfs/_*/

# Report build cache (rewritten by every `build_pdf.py --pdf`) and the
# superseded August draft upload
report/_toc_pages.json
report/CuraFinalReport.pdf
# Cited-paper PDFs held locally for fetch_references.py ("local" kind): third-
# party material, 50 MB, not for a public repo. The verification log and
# references-pdfs/manifest.json are the tracked record.
report/references/*.pdf
Thumbs.db
# Working notes: kept on disk, not part of the project
report.bat
report/VIDEO-SCRIPT.md
report/VIDEO-NARRATION.md
report/acknowledgements.md
report/Cura-Preliminary-Report.docx
report/Cura-Preliminary-Report.pdf
